# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://applywise:devpassword@postgres:5432/applywise

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
FRONTEND_URL=http://localhost:5173

# Postgres (used by docker-compose)
POSTGRES_DB=applywise
POSTGRES_USER=applywise
POSTGRES_PASSWORD=devpassword

# Email (Resend)
# Leave RESEND_API_KEY blank in dev to use console backend (emails print to stdout)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Applywise <no-reply@applywise.app>

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# LLM Providers (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payments master switch.
# False (default) = every user gets Premium-equivalent access, pricing UI hidden.
# True = tier limits enforced (max_applications, monthly AI caps, provider gating),
#        pricing UI shown.
# Leave False during beta / testing. Flip to True when you're ready to charge.
PAYMENTS_ENABLED=False
